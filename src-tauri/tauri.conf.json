{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rescicle",
  "version": "0.0.9",
  "identifier": "app.rescicle",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rescicle",
        "width": 1680,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 700,
        "backgroundColor": "#f7f7f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "rescicle project",
    "shortDescription": "Local-first research copilot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
